# Generated by build-copy.py on the way to assets/showcase/; the tracked copy
# is the one build.py installs, not this intermediate.
research-data-v5.js

# Build scratch
_parsed.json

# Backups written before any edit: design-tokens.json.bak by the server,
# *.md.bak before the editor's first change to a markdown file
design-tokens.json.bak
*.md.bak
*.py.bak

# Numbered token snapshots kept by edit-server.py before any write that would
# drop figures. Machine-local safety net.
.token-history/

.DS_Store

# Rendered GIFs and their frame cache -- deliverables for slides, not part of
# the site. Rebuild with `python3 showcase-src/make-gif.py`.
composability*.gif
.gif-frames/
